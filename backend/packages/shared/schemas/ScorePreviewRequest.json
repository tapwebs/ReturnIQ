{
  "$defs": {
    "Category": {
      "enum": [
        "FASHION",
        "BEAUTY",
        "ELECTRONICS",
        "LIFESTYLE",
        "OTHER"
      ],
      "title": "Category",
      "type": "string"
    },
    "DeliveryStatus": {
      "enum": [
        "DELIVERED",
        "RTO",
        "IN_TRANSIT",
        "NDR",
        "LOST"
      ],
      "title": "DeliveryStatus",
      "type": "string"
    },
    "PaymentMode": {
      "enum": [
        "COD",
        "PREPAID",
        "PARTIAL_COD"
      ],
      "title": "PaymentMode",
      "type": "string"
    },
    "PreviewHistoryItem": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delivered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered At"
        },
        "delivery_status": {
          "$ref": "#/$defs/DeliveryStatus",
          "default": "DELIVERED"
        },
        "order_amount_paise": {
          "default": 0,
          "minimum": 0,
          "title": "Order Amount Paise",
          "type": "integer"
        },
        "order_date": {
          "format": "date-time",
          "title": "Order Date",
          "type": "string"
        },
        "payment_mode": {
          "$ref": "#/$defs/PaymentMode",
          "default": "PREPAID"
        },
        "return_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReturnReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "return_requested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Requested At"
        }
      },
      "required": [
        "order_date"
      ],
      "title": "PreviewHistoryItem",
      "type": "object"
    },
    "PreviewOrder": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "customer_id": {
          "default": "cus_preview",
          "title": "Customer Id",
          "type": "string"
        },
        "order_amount_paise": {
          "minimum": 0,
          "title": "Order Amount Paise",
          "type": "integer"
        },
        "order_date": {
          "format": "date-time",
          "title": "Order Date",
          "type": "string"
        },
        "order_id": {
          "default": "ord_preview",
          "title": "Order Id",
          "type": "string"
        },
        "payment_mode": {
          "$ref": "#/$defs/PaymentMode"
        },
        "pincode": {
          "anyOf": [
            {
              "pattern": "^\\d{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pincode"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "sku_id": {
          "default": "sku_preview",
          "title": "Sku Id",
          "type": "string"
        }
      },
      "required": [
        "order_date",
        "payment_mode",
        "order_amount_paise"
      ],
      "title": "PreviewOrder",
      "type": "object"
    },
    "PreviewReturnRequest": {
      "additionalProperties": false,
      "properties": {
        "delivered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered At"
        },
        "return_reason": {
          "$ref": "#/$defs/ReturnReason"
        },
        "return_requested_at": {
          "format": "date-time",
          "title": "Return Requested At",
          "type": "string"
        }
      },
      "required": [
        "return_requested_at",
        "return_reason"
      ],
      "title": "PreviewReturnRequest",
      "type": "object"
    },
    "ReturnReason": {
      "enum": [
        "SIZE_FIT",
        "CHANGED_MIND",
        "NOT_AS_DESCRIBED",
        "DEFECTIVE",
        "DAMAGED_IN_TRANSIT",
        "WRONG_ITEM",
        "OTHER"
      ],
      "title": "ReturnReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "history": {
      "items": {
        "$ref": "#/$defs/PreviewHistoryItem"
      },
      "title": "History",
      "type": "array"
    },
    "order": {
      "$ref": "#/$defs/PreviewOrder"
    },
    "return_request": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreviewReturnRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "order"
  ],
  "title": "ScorePreviewRequest",
  "type": "object"
}
