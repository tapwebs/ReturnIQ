{
  "$defs": {
    "ActionType": {
      "enum": [
        "NORMAL_FULFILMENT",
        "OTP_VERIFICATION",
        "UPI_PREPAID_INCENTIVE",
        "PARTIAL_PREPAID",
        "PREPAID_ONLY",
        "HOLD_FULFILMENT",
        "SELLER_RESTRICTION",
        "INSTANT_RETURN",
        "PHOTO_VERIFICATION",
        "EXCHANGE_OR_STORE_CREDIT",
        "MANUAL_REVIEW",
        "REFUND_AFTER_QC",
        "RESTRICT_RETURN_METHOD",
        "RESTRICT_COD_PINCODE",
        "CHANGE_POLICY_THRESHOLD"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "AgentProvider": {
      "enum": [
        "GEMINI",
        "GROQ",
        "PLAYBOOK"
      ],
      "title": "AgentProvider",
      "type": "string"
    },
    "CostDefaults": {
      "additionalProperties": false,
      "properties": {
        "forward_ship_paise": {
          "default": 6000,
          "title": "Forward Ship Paise",
          "type": "integer"
        },
        "friction_margin_loss_pct": {
          "default": 2.0,
          "title": "Friction Margin Loss Pct",
          "type": "number"
        },
        "handling_paise": {
          "default": 2500,
          "title": "Handling Paise",
          "type": "integer"
        },
        "intervention_cost_paise": {
          "default": 1000,
          "title": "Intervention Cost Paise",
          "type": "integer"
        },
        "packaging_paise": {
          "default": 1500,
          "title": "Packaging Paise",
          "type": "integer"
        },
        "reverse_ship_paise": {
          "default": 8000,
          "title": "Reverse Ship Paise",
          "type": "integer"
        },
        "writeoff_pct": {
          "default": 10.0,
          "title": "Writeoff Pct",
          "type": "number"
        }
      },
      "title": "CostDefaults",
      "type": "object"
    },
    "Effectiveness": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "default": 0.4,
          "title": "Base",
          "type": "number"
        },
        "high": {
          "default": 0.6,
          "title": "High",
          "type": "number"
        },
        "low": {
          "default": 0.2,
          "title": "Low",
          "type": "number"
        }
      },
      "title": "Effectiveness",
      "type": "object"
    },
    "LlmInfo": {
      "additionalProperties": false,
      "properties": {
        "configured": {
          "default": false,
          "title": "Configured",
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "$ref": "#/$defs/AgentProvider",
          "default": "PLAYBOOK"
        }
      },
      "title": "LlmInfo",
      "type": "object"
    },
    "ReadinessMode": {
      "enum": [
        "OBSERVATION",
        "ACTIVE"
      ],
      "title": "ReadinessMode",
      "type": "string"
    },
    "Thresholds": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "default": 70,
          "title": "High",
          "type": "integer"
        },
        "medium": {
          "default": 40,
          "title": "Medium",
          "type": "integer"
        }
      },
      "title": "Thresholds",
      "type": "object"
    },
    "Weights": {
      "additionalProperties": false,
      "properties": {
        "anomaly": {
          "default": 0.2,
          "title": "Anomaly",
          "type": "number"
        },
        "ml": {
          "default": 0.4,
          "title": "Ml",
          "type": "number"
        },
        "rule": {
          "default": 0.4,
          "title": "Rule",
          "type": "number"
        }
      },
      "title": "Weights",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anomaly_enabled": {
      "default": false,
      "title": "Anomaly Enabled",
      "type": "boolean"
    },
    "cost_defaults_paise": {
      "$ref": "#/$defs/CostDefaults"
    },
    "critical_actions": {
      "items": {
        "$ref": "#/$defs/ActionType"
      },
      "title": "Critical Actions",
      "type": "array"
    },
    "effectiveness_assumption": {
      "$ref": "#/$defs/Effectiveness"
    },
    "llm": {
      "$ref": "#/$defs/LlmInfo"
    },
    "min_confidence": {
      "default": 0.3,
      "title": "Min Confidence",
      "type": "number"
    },
    "mode": {
      "$ref": "#/$defs/ReadinessMode",
      "default": "ACTIVE"
    },
    "return_window_days": {
      "default": 7,
      "title": "Return Window Days",
      "type": "integer"
    },
    "thresholds": {
      "$ref": "#/$defs/Thresholds"
    },
    "weights": {
      "$ref": "#/$defs/Weights"
    }
  },
  "title": "Settings",
  "type": "object"
}
